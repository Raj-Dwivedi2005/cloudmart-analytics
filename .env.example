# AWS Configuration
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_access_key_here
AWS_SECRET_ACCESS_KEY=your_secret_key_here

# S3 Data Lake Buckets
S3_RAW_BUCKET=cloudmart-raw-zone-dev
S3_CURATED_BUCKET=cloudmart-curated-zone-dev
S3_SCRIPTS_BUCKET=cloudmart-glue-scripts-dev

# Redshift Serverless Configuration
REDSHIFT_HOST=cloudmart-workgroup.123456789012.us-east-1.redshift-serverless.amazonaws.com
REDSHIFT_PORT=5439
REDSHIFT_DATABASE=cloudmart_dw
REDSHIFT_USER=admin
REDSHIFT_PASSWORD=ChangeMe123!

# Athena Configuration
ATHENA_WORKGROUP=cloudmart-analytics-wg
ATHENA_OUTPUT_LOCATION=s3://cloudmart-curated-zone-dev/athena-results/

# Amazon Bedrock Configuration
BEDROCK_MODEL_ID=anthropic.claude-3-haiku-20240307-v1:0
# Fallback model: amazon.titan-text-express-v1
